# ─── ConceptsIn5 Backend .env.example ──────────────────────────
# Copy this file to .env for local development.
# NEVER commit the real .env file to git.
# Set production values directly in Render's environment variables dashboard.

# ─── Django Core ────────────────────────────────────────────────
ENVIRONMENT=local
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-minimum-50-chars-random
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database ───────────────────────────────────────────────────
# Option A — Avian PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@host/conceptsin5?sslmode=require

# Option B — Individual credentials (fallback)
# DB_NAME=conceptsin5_db
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=your-db-host.avian.tech
# DB_PORT=5432

# ─── CMS Admin Credentials (used during DB initialization) ──────
CMS_ADMIN_USERNAME=om
CMS_ADMIN_PASSWORD=your-secure-cms-password

# ─── CORS & CSRF ────────────────────────────────────────────────
# Production: add your actual domains
CORS_ALLOWED_ORIGINS=https://conceptsin5.com,https://www.conceptsin5.com
CSRF_TRUSTED_ORIGINS=https://conceptsin5.com,https://www.conceptsin5.com

# ─── YouTube API ────────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# ─── Media Storage (Cloudinary — required for Render) ──────────
# Sign up free at cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Error Tracking (Sentry — optional but recommended) ─────────
# Get DSN from sentry.io → New Project → Django
SENTRY_DSN=your-sentry-dsn-url
