# ─── Django Core ───────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=conceptsin5.com,www.conceptsin5.com,your-ec2-ip

# ─── Database (AWS RDS) ────────────────────────────────────
DB_NAME=conceptsin5_db
DB_USER=postgres
DB_PASSWORD=your-rds-password
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432

# ─── YouTube API ───────────────────────────────────────────
YOUTUBE_API_KEY=your-api-key
YOUTUBE_CHANNEL_ID=your-channel-id

# ─── CORS ──────────────────────────────────────────────────
# Add your frontend domain (e.g., https://conceptsin5.com)
CORS_ALLOWED_ORIGINS=https://conceptsin5.com,https://www.conceptsin5.com
